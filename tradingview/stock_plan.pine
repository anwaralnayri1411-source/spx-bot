//@version=5
// ============================================================================
// Stock Plan | خطة الأسهم (تعليمي وليس توصية)
// يعمل على أي سهم أمريكي، فريم 5 دقائق. الإشارة: CALL أو PUT مع خطوط الدخول والهدف والوقف.
// يعتمد على: مستويات أمس، نطاق أول 30 دقيقة، VWAP، القوة النسبية مقابل SPY، حجم التداول.
// سعر العقد هنا تقدير نظري (بلاك-شولز بتذبذب تاريخي × معامل)، والسعر الحقيقي من دفتر الأوامر.
// تنبيه: Condition = هذا المؤشر | Any alert() function call
// ============================================================================
indicator("Stock Plan", shorttitle="Stock Plan", overlay=true, max_labels_count=300, max_lines_count=100)

if not timeframe.isintraday
    runtime.error("Use an intraday timeframe (5m recommended).")

gS = "Signals"
minEdge = input.float(3.0, "Min bull-bear points gap", minval=0.5, step=0.5, group=gS)
allowCounter = input.bool(false, "Allow counter-bias signals", group=gS)
minRvol = input.float(1.0, "Min relative volume for breakouts", minval=0.0, step=0.1, group=gS)
noEntryH = input.int(15, "No entry after (NY hour)", minval=10, maxval=16, group=gS)
cooldownMin = input.int(30, "Min minutes between signals", minval=5, group=gS)
tolPct = input.float(0.05, "Level touch tolerance %", minval=0.0, step=0.01, group=gS)

gO = "Contract model"
ivMult = input.float(1.3, "IV = historical vol x this", minval=0.3, step=0.05, group=gO)
daysExp = input.int(5, "Days to expiry (calendar)", minval=1, maxval=45, group=gO)
budMin = input.float(100.0, "Min contract price $", minval=10.0, group=gO)
budMax = input.float(300.0, "Max contract price $", minval=20.0, group=gO)
stepIn = input.float(0.0, "Strike step (0 = auto by price)", minval=0.0, group=gO)
riskUsd = input.float(150.0, "Risk budget at stop $", minval=10.0, group=gO)
maxQty = input.int(5, "Max contracts", minval=1, group=gO)
tpPct = input.float(50.0, "Take profit % of contract", minval=5.0, group=gO)
slPct = input.float(40.0, "Stop loss % of contract", minval=5.0, maxval=95.0, group=gO)
holdMin = input.int(60, "Assumed hold minutes (for target)", minval=5, group=gO)

gD = "Display"
spySym = input.string("AMEX:SPY", "Market reference", group=gD)
showTable = input.bool(true, "Show table", group=gD)
showAll = input.bool(false, "Show all past signals (default: last two)", group=gD)
showStats = input.bool(false, "Show paper stats (model prices)", group=gD)

stepUse = stepIn > 0 ? stepIn : (close < 20 ? 0.5 : (close < 50 ? 1.0 : (close < 200 ? 2.5 : 5.0)))

f_ncdf(x) =>
    t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    d = 0.3989423 * math.exp(-x * x / 2.0)
    p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))))
    x > 0 ? 1.0 - p : p

f_bs(S, K, T, iv, isCall) =>
    float res = na
    if T > 0 and iv > 0 and S > 0 and K > 0
        d1 = (math.log(S / K) + (0.04 + 0.5 * iv * iv) * T) / (iv * math.sqrt(T))
        d2 = d1 - iv * math.sqrt(T)
        disc = math.exp(-0.04 * T)
        res := isCall ? S * f_ncdf(d1) - K * disc * f_ncdf(d2) : K * disc * f_ncdf(-d2) - S * f_ncdf(-d1)
    res

f_delta(S, K, T, iv, isCall) =>
    float res = na
    if T > 0 and iv > 0 and S > 0 and K > 0
        d1 = (math.log(S / K) + (0.04 + 0.5 * iv * iv) * T) / (iv * math.sqrt(T))
        res := isCall ? f_ncdf(d1) : f_ncdf(-d1)
    res

// أقرب مستوى فوق المرجع بفارق لا يقل عن gap
f_above(arr, ref, gap) =>
    float best = na
    for i = 0 to array.size(arr) - 1
        v = array.get(arr, i)
        if not na(v) and v > ref + gap
            if na(best) or v < best
                best := v
    best

// أقرب مستوى تحت المرجع بفارق لا يقل عن gap
f_below(arr, ref, gap) =>
    float best = na
    for i = 0 to array.size(arr) - 1
        v = array.get(arr, i)
        if not na(v) and v < ref - gap
            if na(best) or v > best
                best := v
    best

// أول سترايك OTM (من الأقرب للسعر إلى الأبعد) يقع سعره بين الحدين = أعلى دلتا ضمن الميزانية
f_pick(S, T, iv, isCall, step, pMin, pMax) =>
    float bestK = na
    float bestP = na
    base = math.round(S / step) * step
    for i = 0 to 60
        k = isCall ? base + i * step : base - i * step
        otm = isCall ? k > S : k < S
        if otm and na(bestK)
            p = f_bs(S, k, T, iv, isCall) * 100
            if not na(p) and p >= pMin and p <= pMax
                bestK := k
                bestP := p
    [bestK, bestP]

// مستوى الأصل الذي يعطي سعر العقد = target (تقسيم ثنائي)
f_solve(K, T, iv, isCall, target, lo0, hi0) =>
    sg = isCall ? 1.0 : -1.0
    float lo = lo0
    float hi = hi0
    float res = na
    glo = sg * (f_bs(lo, K, T, iv, isCall) - target)
    ghi = sg * (f_bs(hi, K, T, iv, isCall) - target)
    if glo < 0 and ghi > 0
        for i = 0 to 39
            mid = (lo + hi) / 2
            gm = sg * (f_bs(mid, K, T, iv, isCall) - target)
            if gm < 0
                lo := mid
            else
                hi := mid
        res := (lo + hi) / 2
    res


// ------------------------------- Time ---------------------------------------
NYTZ = "America/New_York"
inSess = not na(time(timeframe.period, "0930-1600:23456", NYTZ))
newSess = inSess and not inSess[1]
tfMin = timeframe.in_seconds(timeframe.period) / 60.0
hmOpen = hour(time, NYTZ) * 60 + minute(time, NYTZ)
hmClose = hmOpen + tfMin
minsOpen = hmOpen - 570
minsToClose = 960 - hmClose
noEntryMin = noEntryH * 60
remMin = math.max(daysExp * 1440.0 - (hmClose - 570), 30.0)

// ------------------------------- Data ---------------------------------------
pdH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdL = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
pdC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
d20 = request.security(syminfo.tickerid, "D", ta.sma(close, 20)[1], lookahead=barmerge.lookahead_on)
d50 = request.security(syminfo.tickerid, "D", ta.sma(close, 50)[1], lookahead=barmerge.lookahead_on)
atrD = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead=barmerge.lookahead_on)
hv = request.security(syminfo.tickerid, "D", ta.stdev(math.log(close / close[1]), 20)[1] * math.sqrt(252.0), lookahead=barmerge.lookahead_on)
spyNow = request.security(spySym, timeframe.period, close)
spyPrev = request.security(spySym, "D", close[1], lookahead=barmerge.lookahead_on)

ivNow = na(hv) ? 0.35 * ivMult : hv * ivMult
vwapS = ta.vwap(hlc3)
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
n30 = math.max(1, math.round(30 / tfMin))
r30 = close / close[n30] - 1
rvol = ta.sma(volume, 20) > 0 ? volume / ta.sma(volume, 20) : na
stockChg = not na(pdC) and pdC > 0 ? close / pdC - 1 : na
spyChg = not na(spyNow) and not na(spyPrev) and spyPrev > 0 ? spyNow / spyPrev - 1 : na
rs = not na(stockChg) and not na(spyChg) ? stockChg - spyChg : na

var float orH = na
var float orL = na
var float dayOpen = na
if newSess
    orH := high
    orL := low
    dayOpen := open
else if inSess and minsOpen < 30
    orH := math.max(orH, high)
    orL := math.min(orL, low)
orDone = inSess and minsOpen >= 30 and not na(orH)
gap = not na(dayOpen) and not na(pdC) and pdC > 0 ? dayOpen / pdC - 1 : na

// ------------------------------- Bias ---------------------------------------
float bullP = 0.0
float bearP = 0.0
if not na(d20) and not na(d50)
    if close > d50 and d20 > d50
        bullP += 1
    else if close < d50 and d20 < d50
        bearP += 1
vwUp = na(vwapS) ? 0 : (close > vwapS ? 1 : -1)
emUp = ema9 > ema21 ? 1 : -1
if vwUp + emUp == 2
    bullP += 2
else if vwUp + emUp == -2
    bearP += 2
if r30 > 0.003
    bullP += 1
else if r30 < -0.003
    bearP += 1
if not na(gap)
    if gap >= 0.01
        bullP += 0.5
    else if gap <= -0.01
        bearP += 0.5
if not na(rs)
    if rs >= 0.003
        bullP += 1
    else if rs <= -0.003
        bearP += 1
if not na(spyChg)
    if spyChg >= 0.003
        bullP += 0.5
    else if spyChg <= -0.003
        bearP += 0.5
if orDone
    if close > orH
        bullP += 1.5
    else if close < orL
        bearP += 1.5
if not na(pdH) and not na(pdL)
    if close > pdH
        bullP += 1
    else if close < pdL
        bearP += 1
edge = bullP - bearP
strong = math.abs(edge) >= minEdge
strength = math.min(10.0, math.abs(edge) * 1.5)

// ------------------------------- Levels -------------------------------------
em = na(atrD) ? close * 0.015 : atrD * 0.6
rstep = close < 20 ? 1.0 : (close < 100 ? 5.0 : (close < 500 ? 10.0 : 50.0))
rUp = math.floor(close[1] / rstep) * rstep + rstep
rDn = math.floor(close[1] / rstep) * rstep
lv = array.from(pdH, pdL, orDone ? orH : na, orDone ? orL : na, vwapS, pdC + em, pdC - em, rUp, rDn)
refP = close[1]
R1p = f_above(lv, refP, refP * 0.001)
S1p = f_below(lv, refP, refP * 0.001)
R2p = f_above(lv, na(R1p) ? refP : R1p, refP * 0.003)
S2p = f_below(lv, na(S1p) ? refP : S1p, refP * 0.003)

// ------------------------------- Entries ------------------------------------
tol = tolPct / 100.0
volOk = na(rvol) or rvol >= minRvol
breakoutUp = not na(R1p) and close > R1p and close[1] <= R1p and volOk
bounceUp = not na(S1p) and low <= S1p * (1 + tol) and close > S1p and close > open
rejectDn = not na(R1p) and high >= R1p * (1 - tol) and close < R1p and close < open
breakdownDn = not na(S1p) and close < S1p and close[1] >= S1p and volOk

var label sigA = na
var label sigB = na
var label exA = na
var label exB = na
var line lnEn = na
var line lnTp = na
var line lnSl = na
var label lbEn = na
var label lbTp = na
var label lbSl = na
var int posSide = 0
var float posK = na
var float posPrem = na
var int posQty = 0
var int posBar = na
var int lastSigBar = na
var int trades = 0
var int wins = 0
var float netUsd = 0.0

cooldownBars = math.max(1, math.round(cooldownMin / tfMin))
cooldownOk = na(lastSigBar) or bar_index - lastSigBar >= cooldownBars
canEnter = inSess and minsOpen >= 15 and hmOpen < noEntryMin and posSide == 0 and cooldownOk and not na(close[1])
bullOk = (edge > 0 and strong) or allowCounter
bearOk = (edge < 0 and strong) or allowCounter
sigCall = canEnter and (breakoutUp or bounceUp) and bullOk
sigPut = canEnter and (rejectDn or breakdownDn) and bearOk and not sigCall

if sigCall or sigPut
    isC = sigCall
    Tn = remMin / 525600.0
    [kk, pp] = f_pick(close, Tn, ivNow, isC, stepUse, budMin, budMax)
    kind = sigCall ? (breakoutUp ? "Breakout" : "Bounce") : (rejectDn ? "Rejection" : "Breakdown")
    float tgtIdx = na
    if breakoutUp and sigCall
        tgtIdx := na(R2p) ? close + 0.5 * em : R2p
    else if bounceUp and sigCall
        tgtIdx := na(R1p) ? close + 0.5 * em : R1p
    else if rejectDn and sigPut
        tgtIdx := na(S1p) ? close - 0.5 * em : S1p
    else
        tgtIdx := na(S2p) ? close - 0.5 * em : S2p
    if na(kk)
        label.new(bar_index, isC ? low : high, "No strike in budget", style=isC ? label.style_label_up : label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
    else
        premSh = pp / 100.0
        perLoss = pp * slPct / 100.0
        q = math.max(1, math.min(maxQty, math.floor(riskUsd / perLoss)))
        T2 = math.max(Tn - holdMin / 525600.0, 30.0 / 525600.0)
        tpIdx = f_solve(kk, T2, ivNow, isC, premSh * (1 + tpPct / 100.0), isC ? close : close * 0.8, isC ? close * 1.2 : close)
        slIdx = f_solve(kk, Tn, ivNow, isC, premSh * (1 - slPct / 100.0), isC ? close * 0.8 : close, isC ? close : close * 1.2)
        posSide := isC ? 1 : -1
        posK := kk
        posPrem := premSh
        posQty := int(q)
        posBar := bar_index
        lastSigBar := bar_index
        tpShow = na(tpIdx) ? tgtIdx : tpIdx
        txt = (isC ? "CALL ▲ " : "PUT ▼ ") + kind + "\n" + str.tostring(kk, "#.##") + " ~$" + str.tostring(pp, "#") + " x" + str.tostring(q) + "  edge " + str.tostring(strength, "#.0") + "/10"
        if not showAll
            label.delete(sigB)
            sigB := sigA
            label.delete(exB)
            exB := exA
        sigA := label.new(bar_index, isC ? low : high, txt, style=isC ? label.style_label_up : label.style_label_down, color=isC ? color.new(color.green, 5) : color.new(color.red, 5), textcolor=color.white, size=size.small)
        line.delete(lnEn)
        line.delete(lnTp)
        line.delete(lnSl)
        label.delete(lbEn)
        label.delete(lbTp)
        label.delete(lbSl)
        lnEn := line.new(bar_index, close, bar_index + 1, close, extend=extend.right, color=color.white, width=2)
        lbEn := label.new(bar_index + 4, close, "ENTRY " + str.tostring(close, "#.00"), style=label.style_label_left, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)
        if not na(tpShow)
            lnTp := line.new(bar_index, tpShow, bar_index + 1, tpShow, extend=extend.right, color=color.lime, style=line.style_dashed, width=2)
            lbTp := label.new(bar_index + 4, tpShow, "TARGET " + str.tostring(tpShow, "#.00"), style=label.style_label_left, color=color.new(color.green, 10), textcolor=color.white, size=size.small)
        if not na(slIdx)
            lnSl := line.new(bar_index, slIdx, bar_index + 1, slIdx, extend=extend.right, color=color.red, style=line.style_dashed, width=2)
            lbSl := label.new(bar_index + 4, slIdx, "STOP " + str.tostring(slIdx, "#.00"), style=label.style_label_left, color=color.new(color.red, 10), textcolor=color.white, size=size.small)
        alert(syminfo.ticker + " " + (isC ? "CALL" : "PUT") + " (" + kind + ") | Price " + str.tostring(close, "#.00") + " | Strike " + str.tostring(kk, "#.##") + " ~$" + str.tostring(pp, "#") + " x" + str.tostring(q) + " | TP " + (na(tpShow) ? "?" : str.tostring(tpShow, "#.00")) + " | SL " + (na(slIdx) ? "?" : str.tostring(slIdx, "#.00")) + " | Model price, check the real book", alert.freq_once_per_bar_close)

// ------------------------------- Position follow-up -------------------------
float posPnl = na
if posSide != 0 and bar_index > posBar
    isCp = posSide == 1
    Tx = remMin / 525600.0
    valFav = f_bs(isCp ? high : low, posK, Tx, ivNow, isCp)
    valAdv = f_bs(isCp ? low : high, posK, Tx, ivNow, isCp)
    valEnd = f_bs(close, posK, Tx, ivNow, isCp)
    posPnl := valEnd / posPrem - 1
    string why = ""
    float exitVal = na
    if not na(valAdv) and valAdv <= posPrem * (1 - slPct / 100.0)
        why := "STOP HIT"
        exitVal := posPrem * (1 - slPct / 100.0)
    else if not na(valFav) and valFav >= posPrem * (1 + tpPct / 100.0)
        why := "TARGET HIT"
        exitVal := posPrem * (1 + tpPct / 100.0)
    else if hmClose >= 955 or not inSess
        why := "END OF DAY"
        exitVal := na(valEnd) ? posPrem : valEnd
    if why != ""
        pl = (exitVal - posPrem) * 100 * posQty
        trades += 1
        wins += pl > 0 ? 1 : 0
        netUsd += pl
        exA := label.new(bar_index, close, "EXIT: " + why + "  " + (pl >= 0 ? "+" : "") + str.tostring(pl, "#") + "$", style=label.style_label_left, color=pl > 0 ? color.new(color.teal, 5) : color.new(color.maroon, 5), textcolor=color.white, size=size.small)
        line.set_extend(lnEn, extend.none)
        line.set_extend(lnTp, extend.none)
        line.set_extend(lnSl, extend.none)
        line.set_x2(lnEn, bar_index)
        line.set_x2(lnTp, bar_index)
        line.set_x2(lnSl, bar_index)
        alert(syminfo.ticker + " EXIT (" + why + ") | Paper P/L " + str.tostring(pl, "#") + "$ | Price " + str.tostring(close, "#.00"), alert.freq_once_per_bar_close)
        posSide := 0
        posBar := na

// ------------------------------- Drawing ------------------------------------
plot(pdH, "Y-High", color=color.new(color.orange, 30), style=plot.style_linebr)
plot(pdL, "Y-Low", color=color.new(color.orange, 30), style=plot.style_linebr)
plot(orDone ? orH : na, "30m-High", color=color.new(color.aqua, 30), style=plot.style_linebr)
plot(orDone ? orL : na, "30m-Low", color=color.new(color.aqua, 30), style=plot.style_linebr)
plot(vwapS, "VWAP", color=color.new(color.yellow, 20), linewidth=2)

var line lnR1 = na
var line lnS1 = na
var label lbR1 = na
var label lbS1 = na
if barstate.islast
    line.delete(lnR1)
    line.delete(lnS1)
    label.delete(lbR1)
    label.delete(lbS1)
    r1 = f_above(lv, close, close * 0.001)
    s1 = f_below(lv, close, close * 0.001)
    if not na(r1)
        lnR1 := line.new(bar_index - 20, r1, bar_index + 5, r1, extend=extend.right, color=color.red, width=2)
        lbR1 := label.new(bar_index + 6, r1, "RESIST " + str.tostring(r1, "#.00"), style=label.style_label_left, color=color.new(color.red, 15), textcolor=color.white, size=size.small)
    if not na(s1)
        lnS1 := line.new(bar_index - 20, s1, bar_index + 5, s1, extend=extend.right, color=color.green, width=2)
        lbS1 := label.new(bar_index + 6, s1, "SUPPORT " + str.tostring(s1, "#.00"), style=label.style_label_left, color=color.new(color.green, 15), textcolor=color.white, size=size.small)

// ------------------------------- Table --------------------------------------
var table tb = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 25), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast and showTable
    sideTxt = edge >= minEdge ? "CALL side 🟢" : (edge <= -minEdge ? "PUT side 🔴" : "WAIT ⚪ (no clear side)")
    rr1 = f_above(lv, close, close * 0.001)
    ss1 = f_below(lv, close, close * 0.001)
    table.cell(tb, 0, 0, "Bias", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 1, 0, sideTxt + "  (" + str.tostring(bullP, "#.0") + " vs " + str.tostring(bearP, "#.0") + ")", text_color=edge >= minEdge ? color.lime : (edge <= -minEdge ? color.red : color.white), text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 0, 1, "Resist", text_color=color.red, text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 1, 1, na(rr1) ? "-" : str.tostring(rr1, "#.00") + "  (+" + str.tostring(rr1 - close, "#.00") + ")", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 0, 2, "Support", text_color=color.lime, text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 1, 2, na(ss1) ? "-" : str.tostring(ss1, "#.00") + "  (-" + str.tostring(close - ss1, "#.00") + ")", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 0, 3, "vs SPY", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 1, 3, na(rs) ? "n/a" : (rs >= 0 ? "stronger +" : "weaker ") + str.tostring(rs * 100, "#.0") + "%  | RVOL " + (na(rvol) ? "n/a" : str.tostring(rvol, "#.0")), text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    posTxt = posSide == 0 ? "none" : ((posSide == 1 ? "CALL " : "PUT ") + str.tostring(posK, "#.##") + " x" + str.tostring(posQty) + (na(posPnl) ? "" : "  " + str.tostring(posPnl * 100, "#") + "%"))
    table.cell(tb, 0, 4, "Position", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 1, 4, posTxt, text_color=posSide == 1 ? color.lime : (posSide == -1 ? color.red : color.white), text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 0, 5, "Frame", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(tb, 1, 5, tfMin == 5 ? "5m OK" : "SET 5m!", text_color=tfMin == 5 ? color.white : color.orange, text_size=size.normal, text_halign=text.align_left)
    if showStats
        table.cell(tb, 0, 6, "Paper", text_color=color.yellow, text_size=size.small, text_halign=text.align_left)
        table.cell(tb, 1, 6, str.tostring(trades) + " trades, model prices, not real", text_color=color.yellow, text_size=size.small, text_halign=text.align_left)
